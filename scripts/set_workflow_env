#!/usr/bin/env python3
"""Set one allowed Grafana workflow variable in the workspace .env."""

from __future__ import annotations

import json
import sys
from pathlib import Path
from urllib.parse import urlsplit

from grafana_access import ENV_KEYS, UID_RE, AccessError, grafana_env, workflow_env_path, write_workflow_env


def fail(message: str) -> int:
    print(f"ERROR workflow-env: {message}", file=sys.stderr)
    return 2


def valid(name: str, value: str) -> bool:
    if "\x00" in value:
        return False
    if name == "METRICS_HTTP_CLIENT":
        return not value or "/" not in value or Path(value).is_absolute()
    if not value:
        return False
    if name == "GRAFANA_TARGET":
        parsed = urlsplit(value)
        return (
            parsed.scheme in {"http", "https"}
            and bool(parsed.netloc)
            and not parsed.query
            and not parsed.fragment
        )
    if name == "GRAFANA_HTTP_CLIENT":
        return "/" not in value or Path(value).is_absolute()
    if name == "METRICS_TARGET":
        parsed = urlsplit(value)
        if parsed.scheme:
            return (
                parsed.scheme in {"http", "https"}
                and bool(parsed.netloc)
                and not parsed.fragment
            )
        path = Path(value)
        return path.is_file() and not path.is_symlink()
    if name in {"GRAFANA_HTTP_CLIENT_ARGS_JSON", "METRICS_HTTP_CLIENT_ARGS_JSON"}:
        try:
            values = json.loads(value)
        except json.JSONDecodeError:
            return False
        return (
            isinstance(values, list)
            and len(values) <= 16
            and all(isinstance(item, str) and len(item) <= 1024 for item in values)
        )
    if name.startswith("WORKFLOW_"):
        return value in {"true", "false"}
    return UID_RE.fullmatch(value) is not None


def main() -> int:
    if len(sys.argv) != 3:
        return fail("usage: set_workflow_env <name> <value>")
    name, value = sys.argv[1:]
    if name not in ENV_KEYS:
        return fail("environment variable is not allowed")
    if name == "WORKFLOW_RUN_ID":
        return fail("WORKFLOW_RUN_ID is created by mkworkspace")
    if name == "GRAFANA_PROMETHEUS_DATASOURCE_UID":
        return fail("GRAFANA_PROMETHEUS_DATASOURCE_UID is created by set_datasource")
    if not valid(name, value):
        return fail("environment variable value is invalid")
    if name == "METRICS_TARGET" and not urlsplit(value).scheme:
        value = str(Path(value).resolve())
    path = workflow_env_path()
    if path is None:
        return fail("set_workflow_env must run from a dashboard workspace")
    try:
        values = grafana_env(path)
        values[name] = value
        write_workflow_env(path, values)
    except (AccessError, OSError) as error:
        return fail(str(error))
    print("PASS workflow-env")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
